# Copy to supabase/.env (gitignored), from the splitit-app root:  cp supabase/.env.example supabase/.env
# The Supabase CLI reads supabase/.env (then supabase/.env.local, then your shell, which wins)
# whenever it loads config.toml, so `npm run db:start` picks these up with no extra flags.
# Restart the stack (npm run db:stop && npm run db:start) after changing them.
# Never commit real values. Setup guide: docs/setup/google-oauth.md

# Google sign-in (enabled in config.toml). The stack refuses to start if the client ID is empty,
# so these placeholders let it start for database-only work; Google sign-in itself only works
# once you paste the real "Web application" client ID and secret from Google Cloud.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-me

# Apple sign-in: disabled for now, needed before App Store submission.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
