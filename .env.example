# Copy to .env (gitignored) and fill in from `npx supabase status` (run in this repo).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Paste the anon / publishable key (sb_publishable_... or the anon JWT).
# NEVER paste the secret / service_role key: everything EXPO_PUBLIC_* ships in the app bundle.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
 # Optional: the public web address share/invite links point at, e.g. https://splitit-xyz.vercel.app
# (https, no path, no trailing slash needed). Leave empty in dev: links stay http://localhost:8081/b/<code>
# on web and splitit://b/<code> on native. A bad value stops the app at start with an error naming this variable.
EXPO_PUBLIC_WEB_URL=
